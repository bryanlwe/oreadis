<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --green: #4a7c59;
    --green-dark: #3d6849;
    --green-bg: #f0f5f1;
    --grey: #767676;
    --rule: #e2e2e2;
    --max: 680px;
    --body: Georgia, 'Times New Roman', serif;
    --ui: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  html { font-size: 17px; }

  body {
    background: #fff;
    color: #111;
    font-family: var(--body);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  /* ── HEADER ── */
  header {
    position: sticky;
    top: 0;
    background: #fff;
    border-bottom: 1px solid var(--rule);
    z-index: 100;
  }
  .header-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-name {
    font-family: var(--ui);
    font-weight: 700;
    font-size: 0.94rem;
    letter-spacing: 0.02em;
    color: #111;
    text-decoration: none;
  }
  nav { display: flex; gap: 24px; }
  nav a {
    font-family: var(--ui);
    font-size: 0.82rem;
    color: #555;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  nav a:hover, nav a.active { color: var(--green); }

  /* ── LAYOUT ── */
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── AD ── */
  .ad-placeholder {
    border: 1.5px dashed #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ui);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #bbb;
    width: 100%;
  }
  .ad-leader { height: 90px; }
  .ad-rect { height: 250px; margin: 48px 0; }

  /* ── FOOTER ── */
  footer { border-top: 1px solid var(--rule); margin-top: 96px; }
  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    font-family: var(--ui);
    font-size: 0.74rem;
    color: var(--grey);
  }
  .footer-inner a { color: var(--grey); }
  .footer-inner a:hover { color: var(--green); text-decoration: none; }

  /* ── POST PAGE ── */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--ui);
    font-size: 0.79rem;
    color: var(--grey);
    text-decoration: none;
    margin: 28px 0 0;
  }
  .back-btn:hover { color: var(--green); text-decoration: none; }

  .post-header { padding: 32px 0 32px; border-bottom: 1px solid var(--rule); margin-bottom: 32px; }

  .post-meta-top {
    font-family: var(--ui);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey);
    display: flex;
    gap: 16px;
    margin-bottom: 14px;
  }
  .post-meta-top .region { color: var(--green); }

  /* Tag pills — same chip pattern as browse page filters */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }
  .tag-pill {
    font-family: var(--ui);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    padding: 4px 11px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: #fff;
    color: #444;
    text-decoration: none;
    transition: all 0.15s;
    line-height: 1.3;
  }
  .tag-pill:hover {
    border-color: var(--green);
    color: var(--green);
    text-decoration: none;
  }

  h1.post-title-large {
    font-size: 2.1rem;
    font-weight: normal;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  /* Photo placeholder */
  .photo-ph {
    width: 100%;
    height: 380px;
    margin-bottom: 36px;
    background-image: repeating-linear-gradient(
      -45deg,
      #ececec 0px, #ececec 2px,
      #f6f6f6 2px, #f6f6f6 12px
    );
    border: 1px solid #e8e8e8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .photo-ph p {
    font-family: var(--ui);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #b0b0b0;
  }

  /* Post figure — replaces .photo-ph when filling in a post.
     See design-elements.md §5 "Post figure". */
  .post-figure { margin: 0 0 36px; }
  .post-figure-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-figure-caption {
    font-family: var(--ui);
    font-size: 0.78rem;
    font-style: italic;
    color: var(--grey);
    margin-top: 8px;
    text-align: center;
  }

  /* Quick Facts */
  .quick-facts {
    border-left: 3px solid var(--green);
    background: #f7f9f7;
    padding: 18px 22px;
    margin-bottom: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    align-items: flex-start;
  }
  .quick-facts-label {
    font-family: var(--ui);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--green);
    font-weight: 600;
    width: 100%;
    margin-bottom: 2px;
  }
  .qf-key {
    font-family: var(--ui);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey);
    display: block;
    margin-bottom: 2px;
  }
  .qf-val {
    font-family: var(--ui);
    font-size: 0.88rem;
    color: #111;
    font-weight: 500;
  }

  /* Sections */
  .section { margin-bottom: 44px; }
  .section-heading {
    font-family: var(--ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 8px;
    margin-bottom: 20px;
  }
  .section p {
    font-size: 1rem;
    line-height: 1.75;
    color: #1a1a1a;
    margin-bottom: 18px;
  }
  .section p:last-child { margin-bottom: 0; }
  .section ul { list-style: none; padding: 0; margin: 0; }
  .section ul li {
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 10px 0 10px 20px;
    border-bottom: 1px solid #f2f2f2;
    position: relative;
    color: #1a1a1a;
  }
  .section ul li:last-child { border-bottom: none; }
  .section ul li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--green);
    font-size: 0.8rem;
    top: 11px;
    line-height: 1;
  }
  .section .note {
    font-size: 0.92rem;
    color: var(--grey);
    margin-top: 18px;
    margin-bottom: 0;
    line-height: 1.6;
  }
  .section .note strong {
    color: #111;
    font-weight: 600;
  }

  /* Daily stats table — HIKE posts only */
  .table-wrap {
    overflow-x: auto;
    margin: 0 -2px;
  }
  table.daily-stats {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ui);
    font-size: 0.78rem;
  }
  table.daily-stats th {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey);
    text-align: left;
    border-bottom: 1px solid #111;
    padding: 8px 8px 8px 0;
    font-weight: 600;
    white-space: nowrap;
  }
  table.daily-stats th:last-child { padding-right: 0; }
  table.daily-stats td {
    padding: 12px 8px 12px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    color: #1a1a1a;
    line-height: 1.5;
  }
  table.daily-stats td:first-child {
    color: var(--green);
    font-weight: 600;
    width: 28px;
  }
  table.daily-stats td:last-child { padding-right: 0; white-space: nowrap; }
  table.daily-stats td.num {
    font-feature-settings: 'tnum';
    white-space: nowrap;
    color: #333;
  }

  /* Costs table */
  table.costs {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  table.costs th {
    font-family: var(--ui);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--grey);
    text-align: left;
    border-bottom: 1px solid #111;
    padding: 8px 0;
    font-weight: 600;
  }
  table.costs th:last-child { text-align: right; }
  table.costs td {
    padding: 11px 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.5;
    vertical-align: top;
  }
  table.costs td:last-child {
    text-align: right;
    font-family: var(--ui);
    font-feature-settings: 'tnum';
    color: #333;
  }
  table.costs tr.total td {
    border-top: 1px solid #111;
    border-bottom: none;
    font-weight: 700;
    padding-top: 14px;
    font-family: var(--ui);
  }
  table.costs tr.total td:last-child { color: #111; }

  a { color: var(--green); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
